<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
	<Fragment>
		<DirectoryRef Id="HEADERS_INCLUDE_MATH">
			<Component Id="HeaderFiles" Guid="{EC66E45D-6F05-40F5-ACD9-971F78B56C44}">
				<File Id="HeaderFile1" Source="..\..\..\..\common\include\math\3dmath.h" />
				<File Id="HeaderFile2" Source="..\..\..\..\common\include\math\angle.h" />
				<File Id="HeaderFile3" Source="..\..\..\..\common\include\math\anglebr.h" />
				<File Id="HeaderFile4" Source="..\..\..\..\common\include\math\asine.h" />
				<File Id="HeaderFile5" Source="..\..\..\..\common\include\math\atan.h" />
				<File Id="HeaderFile6" Source="..\..\..\..\common\include\math\recip.h" />
				<File Id="HeaderFile7" Source="..\..\..\..\common\include\math\rotation.h" />
				<File Id="HeaderFile8" Source="..\..\..\..\common\include\math\scalar.h" />
				<File Id="HeaderFile9" Source="..\..\..\..\common\include\math\sine.h" />
				<File Id="HeaderFile10" Source="..\..\..\..\common\include\math\sqrt.h" />
				<File Id="HeaderFile11" Source="..\..\..\..\common\include\math\transfrm.h" />
				<File Id="HeaderFile12" Source="..\..\..\..\common\include\math\trig.h" />
				<File Id="HeaderFile13" Source="..\..\..\..\common\include\math\vector.h" />
			</Component>
		</DirectoryRef>
		<ComponentGroup Id="MlmathComponents" Directory="MLEROOT">
			<Component Id="mlmath_dll_rehearsal_loc" Directory="BIN64_REHEARSAL">
				<File Id="mlmath_dll_rehearsal" Source="$(var.mlmath_DLL.TargetPath)"/>
			</Component>
			<?if $(var.Configuration) = "Debug" ?>
				<!-- Debug Package -->
				<Component Id="mlmath_lib_rehearsal_loc" Directory="LIB64_REHEARSAL">
					<File Id="mlmath_lib_rehearsal" Source="$(var.mlmath_DLL.TargetDir)\mlmathd.lib"/>
				</Component>
				<Component Id="mlmath_lib_runtime_loc" Directory="LIB64_RUNTIME_CDECL">
					<File Id="mlmath_lib_runtime" Source="$(var.mlmath_DLL.TargetDir)\mlmathd.lib"/>
				</Component>
			<?else?>
				<!-- Release Package -->
				<Component Id="mlmath_lib_rehearsal_loc" Directory="LIB64_REHEARSAL">
					<File Id="mlmath_lib_rehearsal" Source="$(var.mlmath_DLL.TargetDir)\mlmath.lib"/>
				</Component>
				<Component Id="mlmath_lib_runtime_loc" Directory="LIB64_RUNTIME_CDECL">
					<File Id="mlmath_lib_runtime" Source="$(var.mlmath_DLL.TargetDir)\mlmath.lib"/>
				</Component>
			<?endif?>
			<ComponentRef Id="HeaderFiles" />
		</ComponentGroup>
	</Fragment>
</Wix>
